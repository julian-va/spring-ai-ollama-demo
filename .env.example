# Example environment variables for docker-compose (production)
# Copy this file to `.env` and fill the real secrets/URIs before running
# Do NOT commit the real `.env` with secrets to the repository.

# Keycloak client secret (required)
KEYCLOAK_CLIENT_SECRET=replace-with-strong-secret

# Keycloak issuer and auth base (internal container addresses)
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/mi-realm
KEYCLOAK_AUTH_URI=http://keycloak:8080

# Suggestions service URL used by API Gateway
SUGGESTIONS_SERVICE_URI=http://spring-boot-service-ms-suggestions:8081

# Optional: override profile for local testing (not recommended in prod)
# SPRING_PROFILES_ACTIVE=prod
